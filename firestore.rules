rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Unico account autorizzato (UID visibile in Firebase > Authentication > Users).
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && uid == "i8X7kZUbiIaZwm6ZM5FC8j2D65U2";
    }

    // Forma minima di una voce del registro: niente campi estranei,
    // tipi corretti, ID del documento coerente con il contenuto.
    // updatedAt deve essere l'ora del server: l'app la usa per leggere
    // solo i documenti cambiati. Le voci eliminate restano come "lapidi"
    // (deleted: true, value vuoto).
    function isValidEntry(entryId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['kind', 'id', 'version', 'value', 'updatedAt', 'deleted'])
        && data.keys().hasAll(['kind', 'id', 'version', 'value', 'updatedAt'])
        && data.updatedAt == request.time
        && (!('deleted' in data) || (data.deleted == true && data.value.size() == 0))
        && data.kind in ['movement', 'balance', 'account', 'label', 'recurring', 'rule', 'import']
        && data.id is string
        && data.id.size() > 0
        && data.id.size() <= 73
        && entryId == data.kind + ':' + data.id
        && data.version is string
        && data.version.size() == 36
        && data.value is map
        && data.value.size() <= 16;
    }

    match /users/{uid}/ledger/{entryId} {
      // Niente cancellazioni dal client: l'app scrive una lapide al loro posto.
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidEntry(entryId);
    }

    // Qualsiasi altro percorso è vietato.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
